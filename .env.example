# ==============================================================================
# Aesthetic Physique Builder - Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your Supabase credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Database & Authentication Configuration
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. Supabase Storage Buckets
# ------------------------------------------------------------------------------
STORAGE_BUCKET_BADGES="badge-artwork"
STORAGE_BUCKET_AVATARS="athlete-avatars"
STORAGE_BUCKET_BINARIES="app-binaries"

# ------------------------------------------------------------------------------
# 3. Web Portals & Operations Console Network Settings
# ------------------------------------------------------------------------------
WEB_PORTAL_HOST="0.0.0.0"
WEB_PORTAL_PORT=8550
DEBUG_MODE="false"

# ------------------------------------------------------------------------------
# 4. Mobile Client Fleet & Version Gating Registry
# ------------------------------------------------------------------------------
LATEST_MOBILE_VERSION="1.2.0"
MIN_REQUIRED_MOBILE_VERSION="1.0.0"
FORCE_UPDATE_ACTIVE="false"
APK_DOWNLOAD_CDN_URL="https://cdn.aestheticphysique.com/builds/AestheticPhysique-v1.2.0.apk"
DOCUMENTATION_URL="https://docs.aestheticphysique.com/athlete-guide"

# ------------------------------------------------------------------------------
# 5. Local Offline SQLite Engine (Defaults)
# ------------------------------------------------------------------------------
SQLITE_DB_NAME="aesthetic_physique.db"
SQLITE_JOURNAL_MODE="WAL"
